# URL pública del sitio (sin "/" final). Cambiar cuando exista dominio.
NEXT_PUBLIC_SITE_URL=https://castora-alpha.vercel.app

# Formulario de contacto (opcional). Sin RESEND_API_KEY el formulario ofrece enviar por WhatsApp.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hola@castora.pe
# Requiere un dominio verificado en Resend; por defecto usa onboarding@resend.dev
CONTACT_FROM_EMAIL=
